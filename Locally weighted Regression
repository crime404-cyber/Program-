import numpy as np

def gaussian_weight(distance, tau=1.0):
    return np.exp(-(distance**2) / (2 * tau**2))

distances = np.array([0, 0.5, 1, 2, 3, 4])

for tau in [0.5, 1.0, 2.0]:
    weights = gaussian_weight(distances, tau)
    print(f"tau = {tau} ->", np.round(weights, 3))


def locally_weighted_regression(x_train, y_train, query_x, tau=1.0):
    x_train = np.asarray(x_train, dtype=float)
    y_train = np.asarray(y_train, dtype=float)

    distances = np.abs(x_train - query_x)
    weights = gaussian_weight(distances, tau)

    x_design = np.column_stack((np.ones(len(x_train)), x_train))

    w = np.diag(weights)

    theta = np.linalg.pinv(
        x_design.T @ w @ x_design
    ) @ (
        x_design.T @ w @ y_train
    )

    query_vector = np.array([1, query_x])

    prediction = query_vector @ theta

    return prediction, weights


x_train = np.array([1, 2, 3, 4, 5, 6, 7, 8])
y_train = np.array([2.1, 3.9, 6.2, 7.8, 10.1, 11.9, 14.2, 15.8])

query_x = float(input("Enter an x value for LWR prediction (1 to 8): "))
tau = float(input("Enter bandwidth tau: "))

prediction, weights = locally_weighted_regression(
