import numpy as np

joint = {
    (0,0): 0.10,
    (0,1): 0.20,
    (1,0): 0.20,
    (1,1): 0.50,
}

def sample_x_given_y(y):
    p_x1 = joint[(1,y)] / (joint[(0,y)] + joint[(1,y)])
    return int(np.random.rand() < p_x1)

def sample_y_given_x(x):
    p_y1 = joint[(x,1)] / (joint[(x,0)] + joint[(x,1)])
    return int(np.random.rand() < p_y1)

np.random.seed(42)

x, y = 0, 0
burn_in = 1000
samples = []

for i in range(burn_in + 10000):
    x = sample_x_given_y(y)
    y = sample_y_given_x(x)

    if i >= burn_in:
        samples.append((x, y))

counts = {}
for state in [(0,0),(0,1),(1,0),(1,1)]:
    counts[state] = samples.count(state) / len(samples)

print("True joint distribution:")
for state, p in joint.items():
    print(state, round(p, 3))

print("\nGibbs estimate:")
for state, p in counts.items():
    print(state, round(p, 3))
