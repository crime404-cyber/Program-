import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split
from sklearn.pipeline import make_pipeline
from sklearn.preprocessing import StandardScaler
from sklearn.neighbors import KNeighborsRegressor
from sklearn.metrics import mean_absolute_error

houses = pd.DataFrame({
    "Area_sqft": [800, 900, 1000, 1100, 1200, 1300, 1400, 1500, 1600, 1800, 2000, 2200],
    "Bedrooms": [1, 2, 2, 2, 2, 3, 3, 3, 3, 3, 4, 4],
    "Price_lakhs": [28, 31, 35, 38, 41, 46, 50, 54, 58, 65, 75, 85]
})

print(houses)

X = houses[["Area_sqft", "Bedrooms"]]
y = houses["Price_lakhs"]

X_train_r, X_test_r, y_train_r, y_test_r = train_test_split(
    X, y, test_size=0.25, random_state=42
)

knn_reg = make_pipeline(
    StandardScaler(),
    KNeighborsRegressor(n_neighbors=3, weights="distance")
)

knn_reg.fit(X_train_r, y_train_r)
pred_price = knn_reg.predict(X_test_r)

print("\nActual prices:   ", y_test_r.to_numpy())
print("Predicted prices:", np.round(pred_price, 2))
print("MAE:", round(mean_absolute_error(y_test_r, pred_price), 2))

area = float(input("Enter house area in square feet: "))
bedrooms = int(input("Enter number of bedrooms: "))

new_house = pd.DataFrame({
    "Area_sqft": [area],
    "Bedrooms": [bedrooms]
})

predicted_price = knn_reg.predict(new_house)[0]

print(f"Estimated house price: {predicted_price:.2f} lakhs")
